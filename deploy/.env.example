# Copy to deploy/.env on the server (setup.sh does it for you). Never commit deploy/.env.
# Comments on their own lines only.

# The server's DNS name from Azure (Public IP -> Configuration -> DNS name label)
SITE_ADDRESS=hvac-ahd.centralindia.cloudapp.azure.com
# Write actions (inject, approve, switch AI) need this key in the dashboard
DEMO_TOKEN=change-me
# openai | ollama | rules
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Building clock when the simulator starts
SIM_START=09:00
