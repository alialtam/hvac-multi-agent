# Copy to .env and fill in. .env is ignored by git: never commit real keys.

# LLM providers
LLM_PROVIDER=openai            # openai | ollama | rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini       # any cheap chat model your account has
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Data side
MQTT_HOST=localhost
MQTT_PORT=1883
DATABASE_URL=                  # empty = SQLite file data/hvac.db
