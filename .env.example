# Copy to .env and fill in. .env is ignored by git: never commit real keys.
# Keep comments on their own lines: "KEY=value  # comment" breaks when the value is empty.

# LLM provider: openai | ollama | rules
LLM_PROVIDER=openai
# Paste your key after the = (no quotes, no spaces)
OPENAI_API_KEY=
# Any cheap chat model your account has
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Data side
MQTT_HOST=localhost
MQTT_PORT=1883
# Leave empty to use the SQLite file data/hvac.db
DATABASE_URL=
